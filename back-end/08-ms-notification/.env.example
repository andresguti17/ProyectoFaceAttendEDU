DATABASE_URL=postgres://postgres:postgres@localhost:5432/faceattend_db?sslmode=disable
PORT=8090
KAFKA_BROKERS=localhost:9092

# --- Canal de correo (SERVICE.md §9.1) -------------------------------------
# SMTP_HOST vacío deshabilita el canal: POST /api/v1/emails responde
# 202 {"status":"skipped"} y solo deja un WARN en los logs.
# Desarrollo local con MailHog (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit):
# Cuenta real (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_STARTTLS=true, SMTP_USERNAME=<tu gmail>, SMTP_FROM=FaceAttend EDU
#   <tu gmail> y SMTP_PASSWORD=<contraseña de aplicación de 16 caracteres>:
#   Google account -> Security -> 2-Step Verification -> App passwords.
#   La contraseña de aplicación va SOLO en SMTP_PASSWORD: EMAIL_INTERNAL_TOKEN
#   es un secreto compartido, nunca una contraseña.
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FaceAttend EDU <no-reply@faceattend.local>
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
# Si se define, el cliente interno (01-ms-identity) debe enviar el header
# X-Internal-Token con el mismo valor. Usa un valor aleatorio (p. ej. un GUID)
# que compose pasa a los dos servicios. Vacío = sin exigencia (red interna).
EMAIL_INTERNAL_TOKEN=

# --- Webhook de alertas (SERVICE.md §9.2) ----------------------------------
# WEBHOOK_URL vacío deshabilita la entrega (no-op). Las alertas con
# alert_type.channel EMAIL/PUSH hacen POST aquí en segundo plano al crearse;
# las DASHBOARD no lo llaman (solo se muestran en la app).
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5
