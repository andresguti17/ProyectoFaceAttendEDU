              }
            ],
            "title": "Finger Number"
          }
        },
        "required": [
          "encoding"
        ],
        "title": "IdentifyFingerprintRequest",
        "type": "object"
      },
      "IdentifyFingerprintSampleRequest": {
        "properties": {
          "data_base64": {
            "minLength": 1,
            "title": "Data Base64",
            "type": "string"
          },
          "finger_number": {
            "anyOf": [
              {
                "maximum": 10.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finger Number"
          },
          "quality": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality"
          },
          "sample_format": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Format"
          }
        },
        "required": [
          "data_base64"
        ],
        "title": "IdentifyFingerprintSampleRequest",
        "type": "object"
      },
      "LivenessStepRequest": {
        "properties": {
          "action_index": {
            "minimum": 0.0,
            "title": "Action Index",
            "type": "integer"
          },
          "challenge_token": {
            "minLength": 1,
            "title": "Challenge Token",
            "type": "string"
          },
          "images": {
            "items": {
              "type": "string"
            },
            "maxItems": 6,
            "minItems": 6,
            "title": "Images",
            "type": "array"
          }
        },
        "required": [
          "challenge_token",
          "action_index",
          "images"
        ],
        "title": "LivenessStepRequest",
        "type": "object"
      },
      "ReviewUpdateRequestIn": {
        "properties": {
          "status": {
            "pattern": "^(Approved|Rejected|In_Review)$",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReviewUpdateRequestIn",
        "type": "object"
      },
      "UpdateRequestIn": {
        "properties": {
          "biometric_type": {
            "pattern": "^(FACIAL|FINGERPRINT)$",
            "title": "Biometric Type",
            "type": "string"
          },
          "person_id": {
            "minLength": 1,
            "title": "Person Id",
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "biometric_type",
          "reason"
        ],
        "title": "UpdateRequestIn",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyFacialRequest": {
        "properties": {
          "encoding": {
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "title": "Encoding",
            "type": "array"
          },
          "person_id": {
            "minLength": 1,
            "title": "Person Id",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "encoding"
        ],
        "title": "VerifyFacialRequest",
        "type": "object"
      },
      "VerifyFingerprintRequest": {
        "properties": {
          "encoding": {
            "items": {
