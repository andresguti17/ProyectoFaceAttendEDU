{
  "components": {
    "schemas": {
      "EnrollFacialImageRequest": {
        "properties": {
          "challenge_token": {
            "minLength": 1,
            "title": "Challenge Token",
            "type": "string"
          },
          "image_base64": {
            "minLength": 1,
            "title": "Image Base64",
            "type": "string"
          },
          "model_version": {
            "default": "facenet-v1",
            "title": "Model Version",
            "type": "string"
          },
          "person_id": {
            "minLength": 1,
            "title": "Person Id",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "image_base64",
          "challenge_token"
        ],
        "title": "EnrollFacialImageRequest",
        "type": "object"
      },
      "EnrollFacialRequest": {
        "properties": {
          "encoding": {
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "title": "Encoding",
            "type": "array"
          },
          "model_version": {
            "default": "facenet-v1",
            "title": "Model Version",
            "type": "string"
          },
          "person_id": {
            "minLength": 1,
            "title": "Person Id",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "encoding"
        ],
        "title": "EnrollFacialRequest",
        "type": "object"
      },
      "EnrollFingerprintRequest": {
        "properties": {
          "encoding": {
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "title": "Encoding",
            "type": "array"
          },
          "finger_number": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Finger Number",
            "type": "integer"
          },
          "model_version": {
            "default": "fingerprint-v1",
            "title": "Model Version",
            "type": "string"
          },
          "person_id": {
            "minLength": 1,
            "title": "Person Id",
            "type": "string"
          }
        },
        "required": [
          "person_id",
          "finger_number",
          "encoding"
        ],
        "title": "EnrollFingerprintRequest",
        "type": "object"
      },
      "EnrollFingerprintSampleRequest": {
        "properties": {
          "data_base64": {
            "minLength": 1,
            "title": "Data Base64",
            "type": "string"
          },
          "finger_number": {
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Finger Number",
            "type": "integer"
          },
          "model_version": {
            "default": "fingerprint-sift-v1",
            "title": "Model Version",
            "type": "string"
          },
          "person_id": {
            "minLength": 1,
            "title": "Person Id",
            "type": "string"
          },
          "quality": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quality"
          },
          "sample_format": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Format"
          }
        },
        "required": [
          "person_id",
          "finger_number",
          "data_base64"
        ],
        "title": "EnrollFingerprintSampleRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IdentifyFacialImageRequest": {
        "properties": {
          "challenge_token": {
            "minLength": 1,
            "title": "Challenge Token",
            "type": "string"
          },
          "image_base64": {
            "minLength": 1,
            "title": "Image Base64",
            "type": "string"
          }
        },
        "required": [
          "image_base64",
          "challenge_token"
        ],
        "title": "IdentifyFacialImageRequest",
        "type": "object"
      },
      "IdentifyFacialRequest": {
        "properties": {
          "encoding": {
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "title": "Encoding",
            "type": "array"
          }
        },
        "required": [
          "encoding"
        ],
        "title": "IdentifyFacialRequest",
        "type": "object"
      },
      "IdentifyFingerprintRequest": {
