# Caddy de producción: solo termina TLS delante de Kong.
# El frontend vive en Vercel, así que aquí no se sirve ningún sitio web.
# API_DOMAIN (en .env.prod): nombre DNS que apunta a este host, p. ej.
# faceattend.duckdns.org. Caddy obtiene y renueva el certificado de Let's Encrypt
# solo; necesita los puertos 80 y 443 abiertos al público.
{$API_DOMAIN} {
	# API only (JSON): forbid framing and sniffing, pin HTTPS, hide the server banner.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy kong-gateway:8000
}
