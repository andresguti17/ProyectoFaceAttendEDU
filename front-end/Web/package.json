{
  "name": "FaceAttend-EDU",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "vendor:digitalpersona": "node scripts/copy-digitalpersona.mjs",
    "prestart": "npm run vendor:digitalpersona",
    "preweb": "npm run vendor:digitalpersona",
    "build": "expo export --platform web",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo start --android",
    "qa": "node tools/qa/run.mjs",
    "qa:rebuild": "node tools/qa/run.mjs --rebuild",
    "qa:api": "node tools/qa/api-matrix.mjs",
    "qa:ui": "node tools/qa/ui-smoke.mjs"
  },
  "dependencies": {
    "@digitalpersona/fingerprint": "^1.0.0",
    "@digitalpersona/websdk": "^1.1.0",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "latest",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^5.0.5",
    "@vladmandic/face-api": "^1.7.14",
    "cross-env": "latest",
    "expo": "^57.0.30",
    "expo-constants": "^57.0.17",
    "expo-document-picker": "^57.0.3",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "^57.0.20",
    "expo-linear-gradient": "^57.0.2",
    "expo-linking": "^57.0.13",
    "expo-splash-screen": "^57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~2.33.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tinycolor2": "^1.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "playwright-core": "^1.64.1",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo/web",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
