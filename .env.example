# FaceAttend EDU — template for the root environment file.
# Copy to `.env` and adjust per machine:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (Linux/macOS)
# Docker Compose auto-loads `.env` next to FULL/docker-compose.yml and uses it
# to interpolate every included file (database/, back-end/). The same file is
# also read by the services when they run outside Docker (Java imports it via
# spring.config.import; Node and Python load it at startup), so it is the
# single source for dev credentials: nothing below is a real secret. Never
# commit production secrets: override them via shell environment or a secrets
# manager.

# Passwords have NO default in compose: `docker compose up` fails until they are
# set. Generate each secret with:  openssl rand -base64 32

# ── PostgreSQL 17 (1 instance, 8 schemas) ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=faceattend_db
POSTGRES_PORT=5432
FACEATTEND_LIQUIBASE_IMAGE=liquibase/liquibase:4.29.0
# Liquibase contexts: `seed` = catalogs (roles, permissions, policies…).
# Production runs only `seed`; `demo` changesets never run there.
LIQUIBASE_CONTEXTS=seed

# ── One database login per service (data isolation, 03-dcl roles) ──
# Required. Each service logs in as <service>_app and can only touch its own
# schema. Use URL-safe values (they go inside connection URLs): openssl rand -hex 24
IDENTITY_DB_PASSWORD=
AUTHORIZATION_DB_PASSWORD=
ACADEMIC_DB_PASSWORD=
SCHEDULING_DB_PASSWORD=
ATTENDANCE_DB_PASSWORD=
CONFIGURATION_DB_PASSWORD=
QUALITY_DB_PASSWORD=
NOTIFICATION_DB_PASSWORD=

# ── MongoDB 7 (biometric vectors) ──
# Authentication is mandatory (mongod --auth). Changing these after the volume
# exists does not change the real password: use database/scripts/rotate-mongo-password.sh
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=faceattend_biometric
MONGO_PORT=27017

# ── MinIO (justification supporting documents, ADR-009) ──
# Required, no defaults. MINIO_KMS_SECRET_KEY = <name>:<base64 of 32 bytes>, e.g.
#   echo "faceattend-key:$(openssl rand -base64 32)"
# It encrypts every stored file (SSE-S3). Back it up: without it the files cannot be read.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_KMS_SECRET_KEY=

# ── Redis 7 (Kong rate-limiting) ──
REDIS_PORT=6379

# ── Kafka 3.8 KRaft (domain events) ──
KAFKA_PORT=9092

# ── Kong gateway ──
KONG_PROXY_PORT=8000
# Production: 127.0.0.1 (Caddy fronts Kong on 80/443). Dev default: 0.0.0.0
KONG_PROXY_BIND_IP=0.0.0.0
KONG_ADMIN_PORT=8001
# Browser origins allowed by CORS (comma-separated, exact scheme://host[:port]).
# Production: the real web domains, e.g. https://<project>.vercel.app (mandatory there).
KONG_CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:8081,http://localhost:19006

# ── Host binding ──
# Data ports (5432, 27017, 6379, 9092) and Kong admin (8001) are always bound
# to 127.0.0.1. BIND_IP only scopes the microservice ports (8081-8089); keep it
# on loopback (never 0.0.0.0 in production). Kong's proxy (8000) and the
# frontend (8090) are published on 0.0.0.0 because browsers and phones need them.
BIND_IP=127.0.0.1

# ── Frontend web (Expo static + nginx) ──
# 8090 — free of clashes (8082 belongs to ms-authorization). If you change it,
# add the new origin to KONG_CORS_ORIGINS.
FRONTEND_PORT=8090
# Browser-reachable backend URL, baked at frontend build time. Leave unset/empty
# (default) so the bundle infers it from the page's own hostname at runtime —
# works from localhost, a LAN IP, or a devtunnel without rebuilding the image.
# Only set this if Kong runs on a DIFFERENT host than the one serving this
# frontend, e.g. EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
EXPO_PUBLIC_API_URL=

# ── Biometría web (06-ms-biometric: registro de rostro, reconocimiento, huella) ──
# Todo es opcional salvo el secreto de abajo: compose trae el resto por defecto.
# El navegador accede vía Kong (/api/v1/biometric/*), nunca directo al servicio.
BIOMETRIC_FINGERPRINT_MATCH_THRESHOLD=8   # huella: nº de keypoints coincidentes (no coseno)
BIOMETRIC_LIVENESS_TTL_SECONDS=120
BIOMETRIC_RATE_LIMIT_MAX_ATTEMPTS=20
BIOMETRIC_RATE_LIMIT_WINDOW_SECONDS=60
BIOMETRIC_MAX_IMAGE_BYTES=3145728
BIOMETRIC_MAX_IMAGE_PIXELS=16000000
# >= 32 caracteres; firma los retos de prueba de vida (liveness), no una sesión.
# Sin valor por defecto (un valor publicado permitiría falsificar retos): openssl rand -hex 32
BIOMETRIC_LIVENESS_CHALLENGE_SECRET=
# Required. AES-256-GCM key for face encodings and fingerprint samples at rest (Ley 1581):
# base64 of 32 random bytes (openssl rand -base64 32). Back it up: without it the templates cannot be read.
BIOMETRIC_ENCRYPTION_KEY=

# ── Canal WebSocket de 06-ms-biometric (WS /api/v1/biometric/ws) ──
# Todo opcional: valores por defecto ya correctos para desarrollo.
# Conexión sin mensajes (ni siquiera un ping) durante este tiempo se cierra.
BIOMETRIC_WS_IDLE_TIMEOUT_SECONDS=60
# TTL y tamaño de la caché de idempotencia por client_message_id (evita
# duplicar un enroll/identify si el cliente reconecta y reenvía el mismo id).
BIOMETRIC_WS_IDEMPOTENCY_TTL_SECONDS=300
BIOMETRIC_WS_IDEMPOTENCY_MAX_ENTRIES=2000

# ── Seed API test data (tools/seed-api-test-data, Node >= 20) ──
SEED_USERNAME=seed.admin
SEED_PASSWORD=
# Admin created with database/scripts/bootstrap-admin.sh (no account ships with the migrations)
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=

# ── SMTP email channel (08-ms-notification, SERVICE.md §9.1) ──
# Only ms-notification reads these (compose passes them through). SMTP_HOST
# empty disables the channel: POST /api/v1/emails answers 202 skipped and the
# service only logs a WARN; 01-ms-identity still returns 202 anti-enumeration.
# Dev mailbox (UI at http://localhost:8025):
#   docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# Real account (Gmail): SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
#   SMTP_STARTTLS=true, SMTP_USERNAME=<your gmail>, SMTP_FROM=FaceAttend EDU
#   <your gmail>, SMTP_PASSWORD=<16-char app password>: Google account ->
#   Security -> 2-Step Verification -> App passwords (your normal password is
#   rejected with "535 5.7.8 Username and Password not accepted").
#   The app password goes ONLY in SMTP_PASSWORD: EMAIL_INTERNAL_TOKEN is a
#   shared secret, never a password.
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=FaceAttend EDU <no-reply@faceattend.local>
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
# Shared secret identity -> notification (X-Internal-Token): any random value
# (e.g. a GUID) that compose passes to both services. Empty = no check.
EMAIL_INTERNAL_TOKEN=

# ── Alert webhook (08-ms-notification, SERVICE.md §9.2) ──
# Only ms-notification reads these. WEBHOOK_URL empty disables delivery
# (no-op): EMAIL/PUSH alert_type.channel alerts otherwise POST a JSON
# payload here in the background when raised; DASHBOARD alerts never call it.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_SECONDS=5

# ── Mobile push (08-ms-notification) ──
# Every alert is pushed through Expo to the actor's registered devices
# (POST /api/v1/device-tokens). PUSH_ENABLED=false turns it off.
# EXPO_PUSH_ACCESS_TOKEN only if the Expo project enforces push security.
PUSH_ENABLED=true
EXPO_PUSH_ACCESS_TOKEN=

# ── Attendance alerts (08-ms-notification) ──
# On class close: students without a record are marked Absent and the instructor gets an
# e-mail; every day at RISK_ALERT_HOUR (server time) students under the school's minimum
# attendance are flagged and e-mailed to their instructors and the school admins.
# Needs a service account (a Super Administrador user) to read the other services, and
# SMTP_HOST above to send mail. Empty = feature off. Each school can switch the e-mails off
# in Configuración (web.notify_email_alert / web.notify_at_risk).
NOTIFICATION_SERVICE_USERNAME=
NOTIFICATION_SERVICE_PASSWORD=
ATTENDANCE_ALERTS_ENABLED=true
RISK_ALERT_HOUR=7
# Daily summary (admins who turned it on) goes out at DAILY_SUMMARY_HOUR; the weekly report
# (admins + instructors, last 7 days) goes out on Mondays at RISK_ALERT_HOUR.
DAILY_SUMMARY_HOUR=19

# ── Credentials email (01-ms-identity -> 08-ms-notification) ──
# Login URL included in the email with the initial credentials of a new user
# (e.g. https://app.example.com/login). Empty = the email has no link. Delivery
# needs SMTP_HOST and EMAIL_INTERNAL_TOKEN above.
APP_LOGIN_URL=

# ── Personal data at rest (01-ms-identity, Ley 1581) ──
# Required. Each: base64 of 32 random bytes (openssl rand -base64 32). PII_ENCRYPTION_KEY
# encrypts document number, e-mail, phone and blood type; PII_HASH_KEY keys the blind
# indexes used by the login. Back them up: without them the data cannot be read.
PII_ENCRYPTION_KEY=
PII_HASH_KEY=

# ── School sign-up (01-ms-identity, POST /api/v1/onboarding/schools) ──
# user_id of a dedicated Super Administrador service account. The public
# sign-up opens a short internal session as this user to create the school and
# its administrator. Empty disables the endpoint (503). Never use a human's id.
# How to create it and read its user_id: README.md, "Alta pública de sedes".
ONBOARDING_SERVICE_USER_ID=

# ── TLS (optional, docker-compose.tls.yml — see COMPOSE.md §10) ──
# Real domain with DNS -> this host (and api.<DOMAIN> for Mobile) for
# automatic Let's Encrypt certs. Left unset, Caddy uses "localhost" with its
# own local CA (fine to test the HTTPS flow, untrusted by real browsers).
DOMAIN=
