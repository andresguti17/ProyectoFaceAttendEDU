# Copy to .env and adjust. Direct microservice URLs bypass the Kong JWT
# gate so seeded data can be created without a token. Web and mobile apps
# keep using the gateway (EXPO_PUBLIC_API_URL=http://<host>:8000).
#
# On a phone/emulator, <host> must be your PC LAN IP (not localhost).
IDENTITY_URL=http://localhost:8081
AUTHORIZATION_URL=http://localhost:8082
ACADEMIC_URL=http://localhost:8083
SCHEDULING_URL=http://localhost:8084
ATTENDANCE_URL=http://localhost:8085
BIOMETRIC_URL=http://localhost:8086
CONFIGURATION_URL=http://localhost:8087
NOTIFICATION_URL=http://localhost:8088
QUALITY_URL=http://localhost:8089

# Parallel request pool for the ~13k requests of a full run (1 = sequential).
SEED_CONCURRENCY=8
# Log every successful request (default only logs failures and progress).
SEED_VERBOSE=0

# Logins created by the seed. POST /api/v1/users bcrypt-hashes the passwords,
# so the plaintext below is only an input, never stored. Local testing only.
# All 80 seeded teachers log in with TEACHER_PASSWORD (username = name.surname).
SEED_USERNAME=carolina.mendoza
SEED_PASSWORD=Admin2026*
INSTRUCTOR_USERNAME=carlos.restrepo
INSTRUCTOR_PASSWORD=Docente2026*
STUDENT_USERNAME=valentina.rios
STUDENT_PASSWORD=Estudiante2026*
TEACHER_PASSWORD=Docente2026*

# Bootstrap admin from DB seeds: the script logs in with it to obtain the
# Bearer token the protected endpoints require.
BOOTSTRAP_USERNAME=admin.faceattend
BOOTSTRAP_PASSWORD=Admin123!ChangeMe
